{
  "name": "secure-copilot",
  "displayName": "Secure Copilot",
  "description": "AI-Powered Developer Copilot for Secure Code Generation",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
    {
        "command": "secureCopilot.analyze",
        "title": "🔐 Secure Copilot: Analyser ce fichier"
    },
    {
        "command": "secureCopilot.login",
        "title": "🔐 Secure Copilot: Se connecter"
    }
]
  },
  "scripts": {
    "vscode:prepublish": "webpack --mode production",
    "compile": "tsc -p ./",
    "webpack": "webpack --mode development",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.74.0",
    "@types/ws": "^8.18.1",
    "ts-loader": "^9.6.2",
    "typescript": "^5.0.0",
    "webpack-cli": "^7.2.3",
    "ws": "^8.21.3"
  }
}
